# Development without Meta: local segmentation + mock health/care guide
SEGMENTATION_PROVIDER=local
HEALTH_PROVIDER=mock

# Switch both to "meta" once the Meta account is active and credits are in
META_API_BASE_URL=https://api.meta.ai/v1
META_API_KEY=
META_SAM_MODEL=sam-3.1
META_VISION_MODEL=muse-spark-1.3

STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./data
REPOSITORY_BACKEND=memory

# Comma-separated client keys for /v1/scans; empty disables auth locally
API_KEYS=
DEMO_SCANS_PER_HOUR=20
CARE_GUIDES_PER_HOUR=30

# Optional JSON overrides for calibrated variegation thresholds, e.g.
# VARIEGATION_THRESHOLDS={"white_max_s": 55, "grade_limits": [3, 15, 35, 60]}
VARIEGATION_THRESHOLDS=

LOG_LEVEL=INFO
LOG_JSON=false
